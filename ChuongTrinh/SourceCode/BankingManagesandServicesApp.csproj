<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);Clients\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Clients\**\*.cs" />
    <Page Remove="Clients\**\*.xaml" />
    <None Remove="Clients\**" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <None Update="database.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
