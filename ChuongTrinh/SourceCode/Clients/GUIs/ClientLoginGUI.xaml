<Window x:Class="BankingClientApp.GUIs.ClientLoginGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ngân hàng số Khách hàng — Nhóm 07" Height="640" Width="960" MinHeight="580" MinWidth="900"
        Background="#E8EFF7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Customer Branded Hero Header -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="NHÓM 07 DIGITAL BANKING • KHÁCH HÀNG" FontSize="11.5" FontWeight="Bold" Foreground="#86EFAC"/>
                    <TextBlock Text="CHUYỂN KHOẢN &amp; DỊCH VỤ KHÁCH HÀNG" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                    <TextBlock Text="Chuyển khoản nội bộ miễn phí, liên ngân hàng 24/7, tra cứu lịch sử tín dụng và dư nợ"
                               FontSize="12.5" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed">
                    <Border x:Name="badgeDb" Background="#164E63" BorderBrush="#67E8F9" BorderThickness="1"
                            CornerRadius="18" Padding="14,5" Margin="0,0,0,6">
                        <TextBlock x:Name="lblDbStatus" Text="Đang kết nối CSDL..." FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnConfigDb" Content="⚙ Đổi Server" Style="{StaticResource SecondaryButton}"
                                Background="#1E4B7A" Foreground="White" BorderBrush="#60A5FA"
                                Padding="10,4" MinHeight="28" FontSize="11.5" Margin="0,0,6,0" Click="btnConfigDb_Click"/>
                        <Button x:Name="btnTestDb" Content="↻ Kiểm tra" Style="{StaticResource SecondaryButton}"
                                Background="#1E4B7A" Foreground="White" BorderBrush="#60A5FA"
                                Padding="10,4" MinHeight="28" FontSize="11.5" Click="btnTestDb_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Optional Server Config Strip -->
        <Border x:Name="pnlServerConfig" Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                Padding="24,10" Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="btnApplyServer" DockPanel.Dock="Right" Content="Áp dụng &amp; Kết nối"
                        Style="{StaticResource PrimaryButton}" MinHeight="34" Margin="8,0,0,0" Click="btnApplyServer_Click"/>
                <TextBlock Text="Tên SQL Server (để trống để tự dò .\SQLEXPRESS):"
                           Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtServerName" MinHeight="34"/>
            </DockPanel>
        </Border>

        <!-- Main Customer Workspace -->
        <Grid Grid.Row="2" Margin="24,20,24,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.15*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Info / Feature Highlights -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Background="#FFFFFF">
                <StackPanel VerticalAlignment="Center">
                    <Border Background="#DCFCE7" CornerRadius="10" Padding="10,4" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <TextBlock Text="CỔNG KHÁCH HÀNG" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                    </Border>
                    <TextBlock Text="Giao dịch nhanh chóng.&#10;An toàn với mã OTP." FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="Ứng dụng dành riêng cho khách hàng cá nhân, tách biệt hoàn toàn với phân hệ Quản trị viên."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Tiện ích hỗ trợ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="• Chuyển khoản nội bộ miễn phí" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Chuyển khoản liên ngân hàng 24/7" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Xác thực OTP 6 chữ số &amp; xuất chứng từ" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Lưu &amp; quản lý danh bạ thụ hưởng" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                            <TextBlock Text="• Tra cứu lịch sử tín dụng, dư nợ &amp; đăng ký vay" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- RIGHT: Logged-in Customer Dashboard (Auto Signed-In) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel x:Name="pnlCustomerDashboard" VerticalAlignment="Center">
                    <!-- Account Card -->
                    <Border Background="{StaticResource AccountCardGradientBrush}" BorderBrush="#38BDF8" BorderThickness="1"
                            CornerRadius="14" Padding="18,16" Margin="0,0,0,16">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#14532D" BorderBrush="#4ADE80" BorderThickness="1"
                                        CornerRadius="12" Padding="10,3" VerticalAlignment="Center">
                                    <TextBlock Text="● Đã đăng nhập" FontSize="11" FontWeight="SemiBold" Foreground="#DCFCE7"/>
                                </Border>
                                <TextBlock x:Name="lblCustomerName" Text="Đang tải tài khoản..." FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock x:Name="lblCustomerMeta" Text="STK: ..." FontSize="12" FontFamily="Consolas" Foreground="#E2E8F0" Margin="0,4,0,14"/>
                            <TextBlock Text="SỐ DƯ KHẢ DỤNG" FontSize="10.5" Foreground="#CBD5E1"/>
                            <TextBlock x:Name="lblCustomerBalance" Text="0 VNĐ" FontSize="22" FontWeight="Bold" Foreground="#86EFAC"/>
                        </StackPanel>
                    </Border>

                    <!-- Primary CTA: Transfer -->
                    <Button x:Name="btnTransfer" Content="💸  Chuyển khoản"
                            Style="{StaticResource SuccessButton}" Height="48" FontSize="14.5" Margin="0,0,0,12" Click="btnTransfer_Click"/>

                    <!-- Secondary Customer Self-Service Features -->
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button x:Name="btnMyCredit" Content="🔍 Lịch sử tín dụng" Style="{StaticResource AccentButton}"
                                Height="40" Margin="0,0,6,0" Click="btnMyCredit_Click"/>
                        <Button x:Name="btnMyDebt" Content="📊 Dư nợ của tôi" Style="{StaticResource PrimaryButton}"
                                Height="40" Margin="6,0,0,0" Click="btnMyDebt_Click"/>
                    </UniformGrid>

                    <Button x:Name="btnApplyLoan" Content="📝 Đăng ký vay vốn trực tuyến"
                            Style="{StaticResource SecondaryButton}" Height="40" Click="btnApplyLoan_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
