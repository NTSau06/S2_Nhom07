<Window x:Class="BankingClientApp.GUIs.TransferGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chuyển khoản ngân hàng" Height="790" Width="1020" MinHeight="700" MinWidth="920"
        Background="#E8EFF7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header + Source Account Card -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnHome" Grid.Column="0" Content="← Trang chủ"
                        Style="{StaticResource SecondaryButton}" Background="#1E4B7A" Foreground="White"
                        BorderBrush="#60A5FA" VerticalAlignment="Center" Margin="0,0,16,0"
                        Padding="14,7" Click="btnHome_Click"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CHUYỂN KHOẢN NGÂN HÀNG" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Chuyển tiền nhanh nội bộ miễn phí và liên ngân hàng 24/7"
                               FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Source Account Summary Pill -->
                <Border Grid.Column="2" Background="#123C69" BorderBrush="#38BDF8" BorderThickness="1"
                        CornerRadius="10" Padding="16,10" MinWidth="320">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="lblSenderName" Text="Khách hàng" FontSize="13.5" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="lblSenderAcc" Text="STK: ..." FontSize="12" FontFamily="Consolas" Foreground="#E2E8F0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Số dư khả dụng" FontSize="11" Foreground="#CBD5E1" HorizontalAlignment="Right"/>
                            <TextBlock x:Name="lblBalance" Text="0 VNĐ" FontSize="16" FontWeight="Bold" Foreground="#86EFAC" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tabbed Content -->
        <TabControl x:Name="tabMain" Grid.Row="1" Margin="18,14,18,14">

            <!-- TAB 1: CHUYỂN KHOẢN -->
            <TabItem Header="Chuyển khoản">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,0,4">
                    <StackPanel>
                        <!-- Lockout Warning Banner -->
                        <Border x:Name="pnlLockWarning" Background="{StaticResource DangerBgBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="lblLockWarning" Foreground="#991B1B" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Main 2-column Transfer Workspace -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT: Transfer Input Form -->
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="Thông tin giao dịch" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                                    <!-- Saved Beneficiary Picker -->
                                    <TextBlock Text="Chọn nhanh từ danh bạ thụ hưởng" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbBeneficiary" DisplayMemberPath="display" Margin="0,0,0,8"
                                              SelectionChanged="cbBeneficiary_SelectionChanged"/>

                                    <!-- Receiver Bank -->
                                    <TextBlock Text="Ngân hàng nhận *" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="cbBank" Margin="0,0,0,8" SelectionChanged="Input_Changed"/>

                                    <!-- Receiver Account -->
                                    <TextBlock Text="Số tài khoản nhận *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtReceiver" MaxLength="20" FontFamily="Consolas" FontSize="14"
                                             TextChanged="Input_Changed" LostFocus="txtReceiver_LostFocus"/>
                                    <!-- Kết quả tra cứu tên chủ tài khoản tự động -->
                                    <Border x:Name="pnlReceiverLookup" CornerRadius="6" Padding="10,6" Margin="0,5,0,8"
                                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock x:Name="lblReceiverLookup" FontSize="12.5" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                                                   Text="Chọn ngân hàng và nhập số tài khoản để tự động hiện tên chủ tài khoản."/>
                                    </Border>

                                    <!-- Amount + Quick Chips -->
                                    <TextBlock Text="Số tiền chuyển (VNĐ) *" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="txtAmount" MaxLength="15" FontSize="15" FontWeight="SemiBold"
                                             TextChanged="txtAmount_TextChanged"/>
                                    <TextBlock x:Name="lblAmountWords" FontSize="12" Foreground="{StaticResource AccentBrush}"
                                               FontStyle="Italic" Margin="2,3,0,6" TextWrapping="Wrap" MinHeight="16"/>

                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="100.000đ" Style="{StaticResource ChipButton}" Tag="100000" Click="QuickAmount_Click"/>
                                        <Button Content="500.000đ" Style="{StaticResource ChipButton}" Tag="500000" Click="QuickAmount_Click"/>
                                        <Button Content="1.000.000đ" Style="{StaticResource ChipButton}" Tag="1000000" Click="QuickAmount_Click"/>
                                        <Button Content="2.000.000đ" Style="{StaticResource ChipButton}" Tag="2000000" Click="QuickAmount_Click"/>
                                        <Button Content="5.000.000đ" Style="{StaticResource ChipButton}" Tag="5000000" Click="QuickAmount_Click"/>
                                    </WrapPanel>

                                    <!-- Description -->
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="lblDescCount" DockPanel.Dock="Right" Text="0/150" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock Text="Nội dung chuyển khoản" Style="{StaticResource FieldLabel}" Margin="0"/>
                                    </DockPanel>
                                    <TextBox x:Name="txtDescription" MaxLength="150" TextChanged="txtDescription_TextChanged" Margin="0,0,0,12"/>

                                    <!-- Form Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="btnReset" Content="Nhập lại" Style="{StaticResource SecondaryButton}"
                                                Padding="18,8" Click="btnReset_Click"/>
                                        <Button x:Name="btnCheck" Grid.Column="2" Content="Kiểm tra thông tin người nhận →"
                                                Style="{StaticResource PrimaryButton}" Padding="20,9" Click="btnCheck_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- RIGHT: Summary, Confirmation & OTP Verification -->
                            <StackPanel Grid.Column="2">
                                <!-- Transfer Rules Info -->
                                <Border x:Name="pnlRules" Style="{StaticResource CardBorder}" Background="#F8FAFC" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Quy định chuyển khoản" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="• Chuyển khoản nội bộ: Miễn phí giao dịch." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBlock Text="• Chuyển liên ngân hàng: Phí 5.500 VNĐ / giao dịch." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBlock Text="• Hạn mức: 10.000 VNĐ – 500.000.000 VNĐ / lần." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBlock Text="• Số dư duy trì tối thiểu sau giao dịch: 50.000 VNĐ." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                        <TextBlock Text="• Mã OTP có hiệu lực 2 phút (sai quá 3 lần tạm khóa 15 phút)." FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 2: Checked Confirmation Card -->
                                <Border x:Name="pnlConfirm" Style="{StaticResource CardBorder}" BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="1.5" Margin="0,0,0,14" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBgBrush}" CornerRadius="10" Padding="8,2">
                                                <TextBlock Text="Hợp lệ" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                                            </Border>
                                            <TextBlock Text="Xác nhận thông tin giao dịch" Style="{StaticResource SectionTitle}" Margin="0"/>
                                        </DockPanel>

                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="Người nhận:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,12,3"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblReceiverName" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="1" Text="Số tài khoản:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,12,3"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblReceiverAcc" FontFamily="Consolas" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="2" Text="Ngân hàng:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,12,3"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblReceiverBank" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="3" Text="Số tiền:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,12,3"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblConfirmAmount" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="4" Text="Phí giao dịch:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,12,3"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblFee" HorizontalAlignment="Right" Margin="0,3"/>

                                                <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8" Background="#E2E8F0"/>

                                                <TextBlock Grid.Row="6" Text="Tổng tiền trừ:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,2,12,2"/>
                                                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="lblTotal" FontSize="16" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Right" Margin="0,2"/>
                                            </Grid>
                                        </Border>

                                        <TextBlock x:Name="lblAfterBalance" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12" HorizontalAlignment="Right"/>

                                        <Button x:Name="btnConfirm" Content="Xác nhận &amp; Gửi mã OTP"
                                                Style="{StaticResource SuccessButton}" Height="40" Click="btnConfirm_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 3: OTP Verification Card -->
                                <Border x:Name="pnlOtp" Style="{StaticResource CardBorder}" Background="#FFFBEB"
                                        BorderBrush="#F59E0B" BorderThickness="1.5" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <Border x:Name="badgeOtpTimer" DockPanel.Dock="Right" Background="#FEF3C7" CornerRadius="10" Padding="10,3">
                                                <TextBlock x:Name="lblOtpTimer" Text="02:00" FontFamily="Consolas" FontWeight="Bold" Foreground="#B45309"/>
                                            </Border>
                                            <TextBlock Text="Xác thực mã OTP" FontSize="14.5" FontWeight="Bold" Foreground="#92400E" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <TextBlock x:Name="lblOtpInfo" FontSize="12.5" Foreground="#78350F" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtOtp" MaxLength="6" FontFamily="Consolas" FontSize="20"
                                                     FontWeight="Bold" HorizontalContentAlignment="Center" Height="42"
                                                     KeyDown="txtOtp_KeyDown"/>
                                            <Button x:Name="btnResendOtp" Grid.Column="2" Content="Gửi lại"
                                                    Style="{StaticResource SecondaryButton}" Height="42" Click="btnResendOtp_Click"/>
                                        </Grid>

                                        <TextBlock x:Name="lblOtpError" Foreground="{StaticResource DangerBrush}" FontWeight="SemiBold"
                                                   FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <Button x:Name="btnVerifyOtp" Content="Xác thực OTP &amp; Chuyển tiền"
                                                Style="{StaticResource PrimaryButton}" Height="40" Click="btnVerifyOtp_Click"/>
                                    </StackPanel>
                                </Border>

                                <!-- Step 4: Transfer Success Card -->
                                <Border x:Name="pnlSuccess" Style="{StaticResource CardBorder}" Background="#F0FDF4"
                                        BorderBrush="#16A34A" BorderThickness="1.5" Visibility="Collapsed">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,10">
                                            <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="10" Padding="9,3">
                                                <TextBlock Text="✔ Thành công" FontSize="11.5" FontWeight="Bold" Foreground="#166534"/>
                                            </Border>
                                            <TextBlock Text="Chuyển khoản thành công!" FontSize="15.5" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <Border Background="#FFFFFF" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Text="Mã giao dịch:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblSuccessId" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="1" Text="Người nhận:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblSuccessReceiver" FontWeight="Bold" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="2" Text="Số tiền:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="lblSuccessAmount" FontSize="15" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="3" Text="Phí giao dịch:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblSuccessFee" HorizontalAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="4" Text="Nội dung:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="lblSuccessDesc" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right" Margin="0,3"/>

                                                <TextBlock Grid.Row="5" Text="Thời gian:" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,10,3"/>
                                                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="lblSuccessTime" HorizontalAlignment="Right" Margin="0,3"/>
                                            </Grid>
                                        </Border>

                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="btnSuccessReceipt" Grid.Column="0" Content="📄 Xuất chứng từ"
                                                    Style="{StaticResource AccentButton}" Height="38" Click="btnSuccessReceipt_Click"/>
                                            <Button x:Name="btnAddToBeneficiary" Grid.Column="2" Content="+ Thêm vào danh bạ"
                                                    Style="{StaticResource PrimaryButton}" Height="38" Click="btnAddToBeneficiary_Click"/>
                                        </Grid>

                                        <Button x:Name="btnTransferNext" Content="↻ Chuyển tiếp (Giao dịch mới)"
                                                Style="{StaticResource SuccessButton}" Height="42" FontSize="14" Click="btnTransferNext_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: LỊCH SỬ GIAO DỊCH -->
            <TabItem Header="Lịch sử giao dịch">
                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox x:Name="cbHistoryType" Width="170" Margin="0,0,8,0" SelectionChanged="cbHistoryType_SelectionChanged"/>
                                <Button x:Name="btnRefreshHistory" Content="Làm mới" Style="{StaticResource SecondaryButton}"
                                        Margin="0,0,8,0" Click="btnRefreshHistory_Click"/>
                                <Button x:Name="btnExportSelected" Content="Xuất chứng từ" Style="{StaticResource AccentButton}"
                                        Click="btnExportSelected_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Lịch sử giao dịch tài khoản" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock x:Name="lblHistorySummary" Style="{StaticResource SubHeaderText}"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid x:Name="dgHistory" Grid.Row="1" MouseDoubleClick="dgHistory_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã giao dịch" Binding="{Binding idtrs}" Width="210">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontSize" Value="12"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Thời gian" Binding="{Binding transactionTime, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                                <DataGridTemplateColumn Header="Loại giao dịch" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding transactionType, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                    CornerRadius="10" Padding="9,3" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding transactionType}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{Binding transactionType, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Số tiền (VNĐ)" Binding="{Binding amount, StringFormat={}{0:N0}}" Width="130">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Nội dung" Binding="{Binding description}" Width="*"/>
                                <DataGridTemplateColumn Header="Trạng thái" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                    CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding status}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="2" Text="Mẹo: Nhấp đúp vào một dòng giao dịch hoặc chọn rồi bấm 'Xuất chứng từ' để mở chứng từ giao dịch."
                                   FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,10,0,0"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- TAB 3: DANH BẠ THỤ HƯỞNG -->
            <TabItem Header="Danh bạ thụ hưởng">
                <Grid Margin="0,12,0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Khung nhập thêm người thụ hưởng mới (chỉ hiện khi bấm nút "+ Thêm danh bạ") -->
                    <Border x:Name="pnlAddBnfForm" Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,12" Visibility="Collapsed">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button x:Name="btnCancelNewBnf" DockPanel.Dock="Right" Content="Đóng"
                                        Style="{StaticResource SecondaryButton}" Padding="12,4" MinHeight="30" FontSize="12"
                                        Click="btnCancelNewBnf_Click"/>
                                <TextBlock Text="Thêm người thụ hưởng mới" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Column="0" Text="Ngân hàng *" Style="{StaticResource FieldLabel}"/>
                                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="cbNewBnfBank" SelectionChanged="NewBnfInput_Changed"/>

                                <TextBlock Grid.Column="2" Text="Số tài khoản *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtNewBnfAcc" MaxLength="20" FontFamily="Consolas"
                                         TextChanged="NewBnfInput_Changed" LostFocus="txtNewBnfAcc_LostFocus"/>

                                <TextBlock Grid.Column="4" Text="Tên chủ tài khoản *" Style="{StaticResource FieldLabel}"/>
                                <TextBox Grid.Row="1" Grid.Column="4" x:Name="txtNewBnfName" MaxLength="150"/>

                                <Button Grid.Row="1" Grid.Column="6" x:Name="btnAddNewBnf" Content="✔ Lưu danh bạ"
                                        Style="{StaticResource SuccessButton}" Click="btnAddNewBnf_Click"/>
                            </Grid>
                            <TextBlock x:Name="lblNewBnfStatus" FontSize="12" FontWeight="SemiBold" Margin="2,6,0,0" Foreground="{StaticResource TextMutedBrush}"
                                       Text="Chọn ngân hàng và nhập số tài khoản để tự động hiện tên chủ tài khoản."/>
                        </StackPanel>
                    </Border>

                    <!-- Danh sách đã lưu -->
                    <Border Grid.Row="1" Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="btnToggleAddBnf" Content="+ Thêm danh bạ" Style="{StaticResource SuccessButton}"
                                            Margin="0,0,8,0" Click="btnToggleAddBnf_Click"/>
                                    <Button x:Name="btnUseBeneficiary" Content="Chuyển tiền ngay" Style="{StaticResource PrimaryButton}"
                                            Margin="0,0,8,0" Click="btnUseBeneficiary_Click"/>
                                    <Button x:Name="btnDeleteBeneficiary" Content="Xóa liên hệ" Style="{StaticResource DangerButton}"
                                            Click="btnDeleteBeneficiary_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Danh bạ thụ hưởng đã lưu" Style="{StaticResource SectionTitle}" Margin="0"/>
                                    <TextBlock x:Name="lblBeneficiarySummary" Style="{StaticResource SubHeaderText}"/>
                                </StackPanel>
                            </DockPanel>

                            <DataGrid x:Name="dgBeneficiaries" Grid.Row="1" MouseDoubleClick="dgBeneficiaries_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tên người thụ hưởng" Binding="{Binding receivername}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Số tài khoản" Binding="{Binding receiveraccount}" Width="180">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Ngân hàng" Binding="{Binding bankname}" Width="240"/>
                                    <DataGridTextColumn Header="Ngày lưu" Binding="{Binding createddate, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
