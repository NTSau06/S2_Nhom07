<local:AuthenticatedWindow x:Class="BankingManagesandServicesApp.GUIs.TransactionLogGUI"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
 Title="Quản lý nhật ký giao dịch" Width="1220" Height="820" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <local:SessionHeader DockPanel.Dock="Top"/>
  <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
     <Button Content="Tín dụng &amp; cho vay" Click="CreditLoan_Click"/>
     <Button Content="Mục tiêu &amp; KPI" Click="Goals_Click"/>
     <Button Content="Tài khoản khách hàng" Click="Accounts_Click" Margin="0"/>
    </StackPanel>
    <StackPanel><TextBlock Text="Quản lý nhật ký giao dịch" FontSize="25" FontWeight="Bold" Foreground="#142D4E"/>
     <TextBlock Text="Chọn giao dịch để xem nhật ký và lập chứng từ." Foreground="#53667C" Margin="0,4,0,16"/></StackPanel>
   </DockPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Mã giao dịch / tài khoản / tên khách hàng"/><TextBox x:Name="KeywordBox" MaxLength="100" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Trạng thái"/><ComboBox x:Name="StatusBox" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Thành công"/><ComboBoxItem Content="Đang xử lý"/><ComboBoxItem Content="Thất bại"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Từ ngày"/><DatePicker x:Name="FromDate" Margin="0,5,0,0" Padding="5"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToDate" Margin="0,5,0,0" Padding="5"/></StackPanel>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="Tìm kiếm" Click="Search_Click"/><Button Content="Đặt lại" Click="Reset_Click" Background="#DCE6F1" Foreground="#142D4E"/></StackPanel>
   </Grid>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Margin="24,0,24,16" Padding="12" Background="#E4EDF6"><TextBlock x:Name="MessageText" Text="Đang tải dữ liệu…" TextWrapping="Wrap"/></Border>
  <Grid Margin="24,0,24,14"><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DataGrid x:Name="TransactionsGrid" SelectionChanged="Transaction_Selected" AutomationProperties.Name="Danh sách giao dịch">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Mã giao dịch" Binding="{Binding Id}" Width="140"/>
     <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountNumber}" Width="135"/>
     <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="160"/>
     <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountText}" Width="160"/>
     <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding TransactionType}" Width="130"/>
     <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115"/>
     <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeText}" Width="165"/>
    </DataGrid.Columns>
   </DataGrid>
   <DockPanel Grid.Row="1" Margin="0,16,0,10">
    <Button x:Name="ReceiptButton" DockPanel.Dock="Right" Content="Xem / Xuất chứng từ" Click="Receipt_Click" IsEnabled="False"/>
    <StackPanel><TextBlock Text="Nhật ký của giao dịch được chọn" FontWeight="SemiBold" FontSize="18"/>
     <TextBlock x:Name="SelectionText" Text="Chưa chọn giao dịch" Foreground="#53667C" Margin="0,4,0,0"/></StackPanel>
   </DockPanel>
   <DataGrid Grid.Row="2" x:Name="LogsGrid" AutomationProperties.Name="Nhật ký giao dịch">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Thời gian" Binding="{Binding Time, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="170"/>
     <DataGridTextColumn Header="Thao tác" Binding="{Binding Action}" Width="145"/>
     <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="120"/>
     <DataGridTextColumn Header="Chi tiết" Binding="{Binding Details}" Width="*" MinWidth="240"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
 </DockPanel>
</local:AuthenticatedWindow>
