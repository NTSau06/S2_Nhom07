<Window x:Class="BankingManagesandServicesApp.GUIs.CreditCardLimitGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý hạn mức thẻ tín dụng" Height="770" Width="1160" MinHeight="680" MinWidth="980"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="22,16">
            <StackPanel>
                <TextBlock Text="QUẢN LÝ HẠN MỨC THẺ TÍN DỤNG" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Tra cứu thẻ tín dụng, điều chỉnh hạn mức theo quy định hạng thẻ và lưu nhật ký kiểm soát (UC1.2.8.2)"
                           FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- 2-Column Main Workspace -->
        <Grid Grid.Row="1" Margin="18,14,18,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Card Search + Tabs (Cards List & Audit History) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search Bar Card -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Mã thẻ / STK / CCCD / Chủ thẻ:" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtKeyword" KeyDown="txtKeyword_KeyDown" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" x:Name="btnSearch" Content="Tìm kiếm" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Click="btnSearch_Click"/>
                        <Button Grid.Column="3" x:Name="btnResetSearch" Content="Tất cả" Style="{StaticResource SecondaryButton}"
                                Click="btnResetSearch_Click"/>
                    </Grid>
                </Border>

                <!-- TabControl: Card List + Adjustment History -->
                <TabControl Grid.Row="1">
                    <TabItem x:Name="tabCards" Header="Danh sách thẻ tín dụng">
                        <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,8,0,0">
                            <DataGrid x:Name="dgCards" SelectionChanged="dgCards_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã thẻ" Binding="{Binding idcard}" Width="82">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Chủ thẻ" Binding="{Binding fullname}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Hạng thẻ" Width="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding cardtype, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                        CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding cardtype}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding cardtype, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Hạn mức hiện tại" Binding="{Binding currentlimit, StringFormat={}{0:N0}}" Width="125">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Tối đa" Binding="{Binding maxlimit, StringFormat={}{0:N0}}" Width="115">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Foreground" Value="#64748B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Trạng thái" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                        CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding status}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>

                    <TabItem x:Name="tabHistory" Header="Nhật ký điều chỉnh hạn mức">
                        <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,8,0,0">
                            <DataGrid x:Name="dgLimitHistory">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Thời gian" Binding="{Binding timestamp, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="130"/>
                                    <DataGridTemplateColumn Header="Kết quả" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding result, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                        CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding result}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding result, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Chi tiết điều chỉnh &amp; Lý do" Binding="{Binding details}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <!-- RIGHT: Visual Credit Card Preview & Limit Adjustment Panel -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="Thẻ đang chọn &amp; Điều chỉnh" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                        <!-- Virtual Credit Card Mockup -->
                        <Border x:Name="cardVisual" Height="162" CornerRadius="14" Padding="16,13" Margin="0,0,0,10"
                                Background="{StaticResource AccountCardGradientBrush}" SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Bank brand + Tier badge -->
                                <DockPanel Grid.Row="0">
                                    <Border x:Name="badgeCardStatus" DockPanel.Dock="Right" Background="#33FFFFFF" CornerRadius="10" Padding="9,3">
                                        <TextBlock x:Name="lblVisualStatus" Text="Chưa chọn" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="NHÓM 07 BANK" FontSize="12" FontWeight="Bold" Foreground="#E2E8F0"/>
                                        <TextBlock x:Name="lblVisualTier" Text="CREDIT CARD" FontSize="10.5" Foreground="#CBD5E1"/>
                                    </StackPanel>
                                </DockPanel>

                                <!-- Chip + Style -->
                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                    <Border Width="38" Height="26" CornerRadius="5" Background="#EAB308" BorderBrush="#FEF08A" BorderThickness="1"/>
                                    <TextBlock x:Name="lblVisualStyle" Text="" FontSize="11.5" Foreground="#E2E8F0" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </StackPanel>

                                <!-- Card Number -->
                                <TextBlock Grid.Row="2" x:Name="lblVisualNumber" Text="••••  ••••  ••••  ----"
                                           FontFamily="Consolas" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,4,0,6"/>

                                <!-- Bottom Row: Holder & Account -->
                                <DockPanel Grid.Row="3">
                                    <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="TÀI KHOẢN" FontSize="9.5" Foreground="#CBD5E1" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="lblVisualAcc" Text="—" FontFamily="Consolas" FontSize="11.5" Foreground="White"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="CHỦ THẺ" FontSize="9.5" Foreground="#CBD5E1"/>
                                        <TextBlock x:Name="lblVisualHolder" Text="CHỌN THẺ BÊN TRÁI" FontSize="12.5" FontWeight="Bold" Foreground="White"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>

                        <!-- Limit Gauge -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock x:Name="lblCurrentLimit" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Text="—"/>
                                    <TextBlock Text="Hạn mức hiện tại:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock x:Name="lblMaxLimit" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Text="—"/>
                                    <TextBlock Text="Tối đa theo hạng thẻ:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </DockPanel>
                                <ProgressBar x:Name="pbLimit" Style="{StaticResource ModernProgressBar}" Maximum="100" Value="0"/>
                            </StackPanel>
                        </Border>

                        <!-- Warning Banner if Card Locked -->
                        <Border x:Name="pnlLockedBanner" Background="{StaticResource DangerBgBrush}" BorderBrush="#FCA5A5" BorderThickness="1"
                                CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="Thẻ hiện đang bị khóa. Theo quy định, chỉ có thể điều chỉnh hạn mức cho thẻ đang ở trạng thái Hoạt động."
                                       Foreground="#991B1B" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Adjustment Inputs -->
                        <TextBlock Text="Hạn mức mới (VNĐ) *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNewLimit" IsEnabled="False" MaxLength="15" FontSize="14.5" FontWeight="SemiBold"
                                 TextChanged="txtNewLimit_TextChanged"/>
                        <TextBlock x:Name="lblNewLimitHint" FontSize="11.5" Foreground="{StaticResource AccentBrush}"
                                   Margin="2,3,0,8" TextWrapping="Wrap" MinHeight="16"/>

                        <!-- Quick Percentage Presets -->
                        <WrapPanel x:Name="pnlPresets" Margin="0,0,0,6" IsEnabled="False">
                            <Button Content="25%" Style="{StaticResource ChipButton}" Tag="25" Click="PresetLimit_Click"/>
                            <Button Content="50%" Style="{StaticResource ChipButton}" Tag="50" Click="PresetLimit_Click"/>
                            <Button Content="75%" Style="{StaticResource ChipButton}" Tag="75" Click="PresetLimit_Click"/>
                            <Button Content="100% tối đa" Style="{StaticResource ChipButton}" Tag="100" Click="PresetLimit_Click"/>
                        </WrapPanel>

                        <TextBlock Text="Lý do điều chỉnh *" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtReason" IsEnabled="False" MaxLength="300" Height="56"
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,12"/>

                        <Button x:Name="btnSave" Content="Lưu thay đổi hạn mức" IsEnabled="False"
                                Style="{StaticResource PrimaryButton}" Height="40" Click="btnSave_Click"/>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
