<Window x:Class="BankingManagesandServicesApp.GUIs.LoginAppGUI"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Đăng nhập • Banking Nhóm 07" Width="850" Height="570" MinWidth="760" MinHeight="550" WindowStartupLocation="CenterScreen">
 <Grid Margin="36"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
  <StackPanel VerticalAlignment="Center" Margin="0,0,40,0">
   <TextBlock Text="BANKING / NHÓM 07" Foreground="#176B97" FontWeight="Bold"/>
   <TextBlock Text="Chứng từ rõ ràng.&#10;Giao dịch minh bạch." FontSize="30" FontWeight="Bold" Foreground="#142D4E" Margin="0,20,0,20" TextWrapping="Wrap"/>
   <TextBlock Text="Tra cứu nhật ký, xem chi tiết và xuất chứng từ giao dịch ngân hàng." TextWrapping="Wrap" Foreground="#53667C"/>
   <Border Background="#E4EDF6" Padding="14" Margin="0,30,0,0"><TextBlock Text="DEMO ĐỒ ÁN&#10;admin.demo / Demo@123456&#10;&#10;Lần đầu sử dụng: bấm Tạo dữ liệu demo." TextWrapping="Wrap"/></Border>
  </StackPanel>
  <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="28" VerticalAlignment="Center">
   <StackPanel x:Name="LoginForm">
    <TextBlock Text="Đăng nhập" FontSize="26" FontWeight="Bold" Foreground="#142D4E"/>
    <TextBlock Text="Dùng tài khoản nhân viên được cấp." Foreground="#53667C" Margin="0,8,0,24"/>
    <TextBlock Text="Tên đăng nhập"/><TextBox x:Name="UsernameBox" MaxLength="50" Margin="0,6,0,16" AutomationProperties.Name="Tên đăng nhập"/>
    <TextBlock Text="Mật khẩu"/><PasswordBox x:Name="PasswordBox" MaxLength="128" Padding="8" Margin="0,6,0,16" AutomationProperties.Name="Mật khẩu"/>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="#B33B30" Margin="0,0,0,12"/>
    <Button Content="Đăng nhập" IsDefault="True" Click="Login_Click" Margin="0,0,0,10"/>
    <Button Content="Tạo dữ liệu demo" Click="Demo_Click" Background="#E4EDF6" Foreground="#142D4E" Margin="0,0,0,10"/>
    <Button Content="Mở nhanh: Quản lý tín dụng &amp; cho vay" Click="OpenCreditLoan_Click" Background="#0F3460" Foreground="White" Margin="0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
