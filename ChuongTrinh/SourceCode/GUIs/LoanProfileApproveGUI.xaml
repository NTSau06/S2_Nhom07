<Window x:Class="BankingManagesandServicesApp.GUIs.LoanProfileApproveGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xét duyệt hồ sơ vay vốn" Height="800" Width="1200" MinHeight="700" MinWidth="1020"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="22,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnModePending" Content="Hồ sơ chờ xử lý" Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" Click="btnModePending_Click"/>
                    <Button x:Name="btnModeAll" Content="Tất cả hồ sơ" Style="{StaticResource SecondaryButton}"
                            Background="#24FFFFFF" Foreground="White" BorderBrush="#55FFFFFF"
                            Margin="0,0,8,0" Click="btnModeAll_Click"/>
                    <Button x:Name="btnRefresh" Content="↻ Làm mới" Style="{StaticResource SecondaryButton}"
                            Background="#24FFFFFF" Foreground="White" BorderBrush="#55FFFFFF"
                            Click="btnRefresh_Click"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="XÉT DUYỆT HỒ SƠ VAY VỐN" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Thẩm định thông tin khách hàng, chứng từ đính kèm, hạn mức - lãi suất - kỳ hạn và phê duyệt hồ sơ (UC1.2.8.4)"
                               FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Card: Loan Profiles Queue -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="lblQueueCount" DockPanel.Dock="Right" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="lblQueueTitle" Text="Hồ sơ đang chờ xử lý (Chờ duyệt / Chờ bổ sung)"
                                   Style="{StaticResource SectionTitle}" Margin="0"/>
                    </DockPanel>

                    <Border x:Name="pnlEmpty" Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="lblEmpty" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                    </Border>

                    <DataGrid x:Name="dgProfiles" Grid.Row="2" SelectionChanged="dgProfiles_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã hồ sơ" Binding="{Binding idloan}" Width="88">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số tài khoản" Binding="{Binding idacc}" Width="124">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding fullname}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số tiền đề nghị (VNĐ)" Binding="{Binding loanamount, StringFormat={}{0:N0}}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Thời hạn" Binding="{Binding loanterm, StringFormat={}{0} tháng}" Width="90"/>
                            <DataGridTextColumn Header="Ngày nộp" Binding="{Binding submissiondate, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                            <DataGridTextColumn Header="Điểm TD" Binding="{Binding creditscore}" Width="75">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="115">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding status}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Bottom 2-Column Appraisal Workbench -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Customer Profile & Attached Docs -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border x:Name="badgeScore" DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="10" Padding="10,3" Visibility="Collapsed">
                                <TextBlock x:Name="lblScoreBadge" FontSize="12" FontWeight="Bold"/>
                            </Border>
                            <TextBlock x:Name="lblInfoTitle" Text="Thông tin hồ sơ khách hàng" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>

                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <TextBlock x:Name="lblInfo" Text="Chọn một hồ sơ ở danh sách phía trên để xem thông tin cá nhân và chứng từ."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20" MinHeight="128"/>
                        </Border>

                        <TextBlock Text="Chứng từ đính kèm" Style="{StaticResource FieldLabel}"/>
                        <ItemsControl x:Name="icDocs">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                                            CornerRadius="8" Padding="10,6" Margin="0,0,8,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📄 " FontSize="12.5"/>
                                            <TextBlock Text="{Binding}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="lblNoDocs" Text="(Chưa có chứng từ đính kèm)" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Appraisal Terms & Decision Actions -->
                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border x:Name="badgeReadOnly" DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="8" Padding="8,2" Visibility="Collapsed">
                                <TextBlock Text="Đã xử lý (Chỉ xem)" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                            </Border>
                            <TextBlock Text="Thẩm định &amp; Quyết định phê duyệt" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.8*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="0.8*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Column="0" Text="Hạn mức duyệt (VNĐ)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="txtAmount" MaxLength="15" FontWeight="SemiBold" TextChanged="TermInput_Changed"/>

                            <TextBlock Grid.Column="2" Text="Lãi suất (%/năm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="txtRate" MaxLength="6" TextChanged="TermInput_Changed"/>

                            <TextBlock Grid.Column="4" Text="Thời hạn (tháng)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="txtTerm" MaxLength="3" TextChanged="TermInput_Changed"/>
                        </Grid>

                        <!-- Live Repayment Preview Box -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                            <TextBlock x:Name="lblMonthlyPreview" Text="Nhập hạn mức, lãi suất và thời hạn để xem ước tính trả nợ hàng tháng."
                                       FontSize="12" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Ghi chú / Lý do (bắt buộc khi Yêu cầu bổ sung hoặc Từ chối)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtNote" MaxLength="400" Height="56" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalContentAlignment="Top" Margin="0,0,0,14"/>

                        <!-- Decision Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnApprove" Grid.Column="0" Content="✔ Phê duyệt"
                                    Style="{StaticResource SuccessButton}" Height="40" IsEnabled="False" Click="btnApprove_Click"/>
                            <Button x:Name="btnSupplement" Grid.Column="2" Content="✎ Yêu cầu bổ sung"
                                    Style="{StaticResource WarningButton}" Height="40" IsEnabled="False" Click="btnSupplement_Click"/>
                            <Button x:Name="btnReject" Grid.Column="4" Content="✘ Từ chối"
                                    Style="{StaticResource DangerButton}" Height="40" IsEnabled="False" Click="btnReject_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
