<Window x:Class="BankingManagesandServicesApp.GUIs.CreditHistorySearchGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tra cứu lịch sử tín dụng" Height="780" Width="1160" MinHeight="680" MinWidth="980"
        Background="#E8EFF7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="22,16">
            <DockPanel>
                <Button x:Name="btnBackHome" DockPanel.Dock="Right" Content="← Quay lại"
                        Style="{StaticResource SecondaryButton}" Background="#1E4B7A" Foreground="White"
                        BorderBrush="#60A5FA" VerticalAlignment="Center" Padding="14,7" Click="btnBackHome_Click"/>
                <StackPanel>
                    <TextBlock x:Name="lblTitle" Text="TRA CỨU LỊCH SỬ TÍN DỤNG" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="lblSubtitle" Text="Tra cứu điểm tín dụng, lịch sử các khoản vay và thẻ tín dụng của khách hàng (UC1.2.8.1)"
                               FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Search Card (Hidden when customer views own credit history) -->
            <Border x:Name="pnlSearch" Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tìm khách hàng (Mã KH / CCCD / STK / SĐT / Họ tên):"
                                   Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" x:Name="txtKeyword" KeyDown="txtKeyword_KeyDown" Margin="0,0,8,0"/>
                        <Button Grid.Column="2" x:Name="btnSearch" Content="Tìm kiếm" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Click="btnSearch_Click"/>
                        <Button Grid.Column="3" x:Name="btnShowAll" Content="Tất cả KH" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0" Click="btnShowAll_Click"/>
                        <Button Grid.Column="4" x:Name="btnDetail" Content="Xem lịch sử TD" Style="{StaticResource AccentButton}"
                                Click="btnDetail_Click"/>
                    </Grid>

                    <DataGrid x:Name="dgCustomers" Height="130" MouseDoubleClick="dgCustomers_MouseDoubleClick"
                              SelectionChanged="dgCustomers_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Số tài khoản" Binding="{Binding idacc}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Họ và tên" Binding="{Binding fullname}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CCCD" Binding="{Binding CCCD}" Width="125">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding phone}" Width="110"/>
                            <DataGridTextColumn Header="Loại tài khoản" Binding="{Binding typeacc}" Width="155"/>
                            <DataGridTextColumn Header="Số dư (VNĐ)" Binding="{Binding money, StringFormat={}{0:N0}}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Selected Customer Credit Profile + KPI Tiles -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <Border Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="lblCustomer" Text="Chưa chọn khách hàng" FontSize="15.5" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock x:Name="lblSummary" Text="Tìm kiếm và chọn một khách hàng để xem chi tiết lịch sử tín dụng."
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 4 Customer Metric Cards -->
                <UniformGrid Columns="4">
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="badgeScoreRating" DockPanel.Dock="Right" Background="#F1F5F9" CornerRadius="8" Padding="8,2">
                                    <TextBlock x:Name="lblScoreRating" Text="—" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                                </Border>
                                <TextBlock Text="Điểm tín dụng" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBlock x:Name="lblScore" Text="—" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,6"/>
                            <ProgressBar x:Name="pbScore" Style="{StaticResource ModernProgressBar}" Minimum="300" Maximum="850" Value="300"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Tổng dư nợ hiện tại" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblTotalDebt" Text="0 VNĐ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,6,0,2"/>
                            <TextBlock x:Name="lblOverdueInfo" Text="Quá hạn: 0 khoản" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Hồ sơ khoản vay" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblLoanCounts" Text="0 hồ sơ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,2"/>
                            <TextBlock x:Name="lblLoanCountsSub" Text="Đang vay: 0 • Tất toán: 0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource KpiCard}">
                        <StackPanel>
                            <TextBlock Text="Thẻ tín dụng sở hữu" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="lblCardCount" Text="0 thẻ" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,6,0,2"/>
                            <TextBlock x:Name="lblCardLimitTotal" Text="Tổng hạn mức: 0 VNĐ" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </StackPanel>

            <!-- Tabbed Loans & Credit Cards -->
            <TabControl Grid.Row="2">
                <TabItem x:Name="tabLoans" Header="Các khoản vay">
                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,8,0,0">
                        <DataGrid x:Name="dgLoans">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã HS" Binding="{Binding idloan}" Width="74">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Số tiền vay" Binding="{Binding loanamount, StringFormat={}{0:N0}}" Width="102"/>
                                <DataGridTextColumn Header="Lãi suất" Binding="{Binding interestrate, StringFormat={}{0:0.##}%}" Width="68"/>
                                <DataGridTextColumn Header="Kỳ hạn" Binding="{Binding loanterm, StringFormat={}{0} th}" Width="66"/>
                                <DataGridTextColumn Header="Đã trả" Binding="{Binding paidamount, StringFormat={}{0:N0}}" Width="98"/>
                                <DataGridTextColumn Header="Còn lại" Binding="{Binding remainamount, StringFormat={}{0:N0}}" Width="98">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Tiến độ trả" Width="96">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <ProgressBar Style="{StaticResource ModernProgressBar}" Value="{Binding paidpercent, Mode=OneWay}" Maximum="100" Height="6"/>
                                                <TextBlock Text="{Binding paidpercenttext, Mode=OneWay}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Nhóm nợ" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding debtgroup, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                    Visibility="{Binding debtgroup, Converter={StaticResource NonEmptyVis}}"
                                                    CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding debtgroup}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding debtgroup, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Điểm TD" Binding="{Binding creditscore}" Width="74"/>
                                <DataGridTemplateColumn Header="Trạng thái" Width="98">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                    CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding status}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tình trạng trả nợ" Binding="{Binding repaymentstate, Mode=OneWay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>

                <TabItem x:Name="tabCards" Header="Thẻ tín dụng">
                    <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,8,0,0">
                        <DataGrid x:Name="dgCards">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Mã thẻ" Binding="{Binding idcard}" Width="95">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontFamily" Value="Consolas"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Hạng thẻ" Width="105">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding cardtype, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                    CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding cardtype}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding cardtype, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Màu sắc" Binding="{Binding cardcolor}" Width="130"/>
                                <DataGridTextColumn Header="Kiểu dáng" Binding="{Binding cardstyle}" Width="125"/>
                                <DataGridTextColumn Header="Hạn mức hiện tại" Binding="{Binding currentlimit, StringFormat={}{0:N0}}" Width="140">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Hạn mức tối đa" Binding="{Binding maxlimit, StringFormat={}{0:N0}}" Width="140"/>
                                <DataGridTemplateColumn Header="Tỷ lệ cấp hạn mức" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Style="{StaticResource ModernProgressBar}" Value="{Binding limitpercent, Mode=OneWay}" Maximum="100" Height="7"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Trạng thái" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                    CornerRadius="10" Padding="9,2" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding status}" FontSize="11.5" FontWeight="SemiBold"
                                                           Foreground="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
