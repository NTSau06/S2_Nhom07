<Window x:Class="BankingManagesandServicesApp.GUIs.DebtTrackingGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Theo dõi dư nợ khách hàng" Height="780" Width="1200" MinHeight="680" MinWidth="1020"
        Background="#E8EFF7"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" RenderOptions.ClearTypeHint="Enabled"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="22,16">
            <DockPanel>
                <Button x:Name="btnBackHome" DockPanel.Dock="Right" Content="← Quay lại"
                        Style="{StaticResource SecondaryButton}" Background="#1E4B7A" Foreground="White"
                        BorderBrush="#60A5FA" VerticalAlignment="Center" Padding="14,7" Click="btnBackHome_Click"/>
                <StackPanel>
                    <TextBlock x:Name="lblHeader" Text="THEO DÕI DƯ NỢ KHÁCH HÀNG" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="lblSubHeader" Text="Tổng hợp dư nợ đang vay, lọc theo nhóm nợ, tình trạng hạn, ngày đến hạn và số tiền còn lại (UC1.2.8.3)"
                               FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 4 KPI Strip -->
            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,12">
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Khoản vay đang hiển thị" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblStatCount" Text="0 khoản" FontSize="21" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Tổng giá trị giải ngân" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblStatLoanTotal" Text="0 VNĐ" FontSize="19" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Tổng dư nợ còn lại" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblStatRemainTotal" Text="0 VNĐ" FontSize="19" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <TextBlock Text="Khoản vay quá hạn" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="lblStatOverdue" Text="0 khoản" FontSize="19" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Filter Card -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="14,12" Margin="0,0,0,12">
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Nhóm nợ" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbGroup" Width="110"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Tình trạng" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="cbState" Width="118"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4">
                        <TextBlock Text="Đến hạn từ" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpFrom" Width="130"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Đến hạn đến" Style="{StaticResource FieldLabel}"/>
                        <DatePicker x:Name="dpTo" Width="130"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,4">
                        <TextBlock Text="Dư nợ từ (VNĐ)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMin" Width="125"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,4">
                        <TextBlock Text="Dư nợ đến (VNĐ)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="txtMax" Width="125"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                        <Button x:Name="btnFilter" Content="Lọc dữ liệu" Style="{StaticResource PrimaryButton}"
                                Margin="0,0,8,0" Click="btnFilter_Click"/>
                        <Button x:Name="btnClear" Content="Bỏ lọc" Style="{StaticResource SecondaryButton}"
                                Click="btnClear_Click"/>
                    </StackPanel>
                </WrapPanel>
            </Border>

            <!-- DataGrid Card + Empty State -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Empty state banner (UC 3a) -->
                    <Border x:Name="pnlEmpty" Grid.Row="0" Background="{StaticResource WarningBgBrush}" BorderBrush="#FDE68A" BorderThickness="1"
                            CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock x:Name="lblEmpty" Text="Danh sách trống — không có khoản dư nợ nào thỏa mãn điều kiện lọc."
                                   Foreground="#92400E" FontWeight="SemiBold"/>
                    </Border>

                    <DataGrid x:Name="dgDebts" Grid.Row="1" SelectionChanged="dgDebts_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã vay" Binding="{Binding idloan}" Width="82">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Số tài khoản" Binding="{Binding idacc}" Width="122">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding fullname}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Nhóm nợ" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding debtgroup, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding debtgroup}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding debtgroup, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Số tiền vay" Binding="{Binding loanamount, StringFormat={}{0:N0}}" Width="115"/>
                            <DataGridTextColumn Header="Đã trả" Binding="{Binding paidamount, StringFormat={}{0:N0}}" Width="110"/>
                            <DataGridTextColumn Header="Còn lại" Binding="{Binding remainamount, StringFormat={}{0:N0}}" Width="115">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Tiến độ trả" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center">
                                            <ProgressBar Style="{StaticResource ModernProgressBar}" Value="{Binding paidpercent, Mode=OneWay}" Maximum="100" Height="6"/>
                                            <TextBlock Text="{Binding paidpercenttext, Mode=OneWay}" FontSize="10.5" Foreground="#64748B" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Đến hạn" Binding="{Binding duedate, Mode=OneWay, StringFormat={}{0:dd/MM/yyyy}}" Width="95"/>
                            <DataGridTemplateColumn Header="Tình trạng" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding debtstate, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding debtstate}" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{Binding debtstate, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Structured Debt Detail & Repayment Breakdown Card -->
            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Loan Info & Progress -->
                    <StackPanel Grid.Column="0">
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Border x:Name="badgeDetailGroup" Background="#F1F5F9" CornerRadius="10" Padding="9,2" Margin="0,0,6,0" Visibility="Collapsed">
                                    <TextBlock x:Name="lblDetailGroup" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="badgeDetailState" Background="#F1F5F9" CornerRadius="10" Padding="9,2" Visibility="Collapsed">
                                    <TextBlock x:Name="lblDetailState" FontSize="11.5" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="lblDetailTitle" Text="Chi tiết khoản dư nợ" Style="{StaticResource SectionTitle}" Margin="0"/>
                        </DockPanel>

                        <TextBlock x:Name="lblDetailInfo" Text="Chọn một khoản dư nợ trong danh sách để xem thông tin chi tiết."
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="20"/>

                        <StackPanel x:Name="pnlProgress" Margin="0,10,0,0" Visibility="Collapsed">
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock x:Name="lblProgressRight" DockPanel.Dock="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock x:Name="lblProgressLeft" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <ProgressBar x:Name="pbDebtProgress" Style="{StaticResource ModernProgressBar}" Maximum="100" Height="9"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: Estimated Monthly Payment Box -->
                    <Border Grid.Column="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="Kỳ thanh toán tháng này (ước tính)" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Tiền gốc ước tính:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="lblEstPrincipal" Text="—" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Text="Tiền lãi tháng này:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="lblEstInterest" Text="—" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,2"/>

                                <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7" Background="#E2E8F0"/>

                                <TextBlock Grid.Row="3" Text="Tổng dự kiến phải trả:" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="lblEstTotal" Text="—" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
