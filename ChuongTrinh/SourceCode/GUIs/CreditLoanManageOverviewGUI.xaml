<Window x:Class="BankingManagesandServicesApp.GUIs.CreditLoanManageOverviewGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý tín dụng &amp; cho vay" Height="770" Width="1120" MinHeight="680" MinWidth="980"
        Background="#F1F5F9"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary Source="/BankingManagesandServicesApp;component/GUIs/CommonStyles.xaml"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Hero Header -->
        <Border Grid.Row="0" Background="{StaticResource HeroGradientBrush}" Padding="24,18">
            <DockPanel>
                <Button x:Name="btnRefresh" DockPanel.Dock="Right" Content="↻ Làm mới số liệu"
                        Style="{StaticResource SecondaryButton}" Background="#26FFFFFF" Foreground="White"
                        BorderBrush="#55FFFFFF" VerticalAlignment="Center" Click="btnRefresh_Click"/>
                <StackPanel>
                    <TextBlock Text="QUẢN LÝ TÍN DỤNG &amp; CHO VAY" FontSize="21" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Trung tâm điều hành nghiệp vụ tín dụng, hạn mức thẻ, theo dõi dư nợ và xét duyệt hồ sơ vay (UC1.2.8)"
                               FontSize="12.5" Foreground="#CBD5E1" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22,18,22,22">

                <!-- 4 Live KPI Summary Cards -->
                <UniformGrid Columns="4" Margin="0,0,0,18">
                    <!-- KPI 1: Pending Loans -->
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0" BorderBrush="#FDE68A">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource WarningBgBrush}" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="Cần xử lý" FontSize="11" FontWeight="SemiBold" Foreground="#92400E"/>
                                </Border>
                                <TextBlock Text="Hồ sơ chờ xét duyệt" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBlock x:Name="lblKpiPending" Text="0 hồ sơ" FontSize="24" FontWeight="Bold" Foreground="#B45309" Margin="0,8,0,2"/>
                            <TextBlock x:Name="lblKpiPendingSub" Text="Chờ duyệt: 0 • Chờ bổ sung: 0" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 2: Total Remaining Debt -->
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0" BorderBrush="#BFDBFE">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#DBEAFE" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="Đang vay" FontSize="11" FontWeight="SemiBold" Foreground="#1E40AF"/>
                                </Border>
                                <TextBlock Text="Tổng dư nợ hiện tại" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBlock x:Name="lblKpiDebt" Text="0 VNĐ" FontSize="22" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,8,0,2"/>
                            <TextBlock x:Name="lblKpiDebtSub" Text="0 khoản vay đang hoạt động" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 3: Overdue Loans -->
                    <Border Style="{StaticResource KpiCard}" Margin="0,0,12,0" BorderBrush="#FECACA">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource DangerBgBrush}" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="Cảnh báo" FontSize="11" FontWeight="SemiBold" Foreground="#991B1B"/>
                                </Border>
                                <TextBlock Text="Khoản vay quá hạn" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBlock x:Name="lblKpiOverdue" Text="0 khoản" FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,2"/>
                            <TextBlock x:Name="lblKpiOverdueSub" Text="Dư nợ quá hạn: 0 VNĐ" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- KPI 4: Credit Cards -->
                    <Border Style="{StaticResource KpiCard}" BorderBrush="#BBF7D0">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBgBrush}" CornerRadius="8" Padding="8,2">
                                    <TextBlock Text="Thẻ TD" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                </Border>
                                <TextBlock Text="Thẻ đang hoạt động" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <TextBlock x:Name="lblKpiCards" Text="0 / 0 thẻ" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,2"/>
                            <TextBlock x:Name="lblKpiCardsSub" Text="Tổng hạn mức: 0 VNĐ" FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 4 Core Functional Modules -->
                <TextBlock Text="Chức năng nghiệp vụ" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                <UniformGrid Columns="2" Rows="2" Margin="0,0,0,18">
                    <!-- Module 1: Credit History Search -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="#DBEAFE" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="🔍" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                <TextBlock Text="Tra cứu lịch sử tín dụng" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Tìm khách hàng theo Mã KH, CCCD, STK, SĐT hoặc Họ tên. Xem điểm tín dụng, các khoản vay và thẻ tín dụng."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnCreditHistory" Grid.Column="2" Content="Mở →" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Center" Padding="18,8" Click="btnCreditHistory_Click"/>
                        </Grid>
                    </Border>

                    <!-- Module 2: Credit Card Limit -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="#DCFCE7" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="💳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                <TextBlock Text="Quản lý hạn mức thẻ tín dụng" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Tra cứu thẻ, xem hạn mức hiện tại theo hạng thẻ (Chuẩn / Vàng / Bạch kim), điều chỉnh hạn mức và ghi nhật ký."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnCardLimit" Grid.Column="2" Content="Mở →" Style="{StaticResource AccentButton}"
                                    VerticalAlignment="Center" Padding="18,8" Click="btnCardLimit_Click"/>
                        </Grid>
                    </Border>

                    <!-- Module 3: Debt Tracking -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="#FEE2E2" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="📊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                <TextBlock Text="Theo dõi dư nợ khách hàng" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Tổng hợp khoản vay đang có dư nợ, lọc theo nhóm nợ (Nhóm 1–5), trong hạn / quá hạn, ngày đến hạn và số tiền."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnDebt" Grid.Column="2" Content="Mở →" Style="{StaticResource PrimaryButton}"
                                    VerticalAlignment="Center" Padding="18,8" Click="btnDebt_Click"/>
                        </Grid>
                    </Border>

                    <!-- Module 4: Loan Profile Approval -->
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="44" Height="44" CornerRadius="10" Background="#FEF3C7" VerticalAlignment="Top" HorizontalAlignment="Left">
                                <TextBlock Text="📋" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,12,0">
                                <TextBlock Text="Xét duyệt hồ sơ vay vốn" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Kiểm tra thông tin khách hàng, chứng từ đính kèm, thẩm định hạn mức - lãi suất - kỳ hạn, phê duyệt hoặc yêu cầu bổ sung."
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="btnApprove" Grid.Column="2" Content="Mở →" Style="{StaticResource SuccessButton}"
                                    VerticalAlignment="Center" Padding="18,8" Click="btnApprove_Click"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Quick Action Watchlists (Pending Loans + Overdue Debts) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Pending Loans Quick List -->
                    <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Xử lý ngay" Style="{StaticResource SecondaryButton}"
                                        Padding="12,5" MinHeight="30" FontSize="12" Click="btnApprove_Click"/>
                                <TextBlock Text="Hồ sơ đang chờ xét duyệt" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="dgPendingQuick" Height="145" MouseDoubleClick="dgPendingQuick_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã HS" Binding="{Binding idloan}" Width="78"/>
                                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding fullname}" Width="*"/>
                                    <DataGridTextColumn Header="Đề nghị (VNĐ)" Binding="{Binding loanamount, StringFormat={}{0:N0}}" Width="115"/>
                                    <DataGridTemplateColumn Header="Trạng thái" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                        CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding status}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding status, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Overdue Debts Quick List -->
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="Xem chi tiết" Style="{StaticResource SecondaryButton}"
                                        Padding="12,5" MinHeight="30" FontSize="12" Click="btnDebt_Click"/>
                                <TextBlock Text="Cảnh báo khoản vay quá hạn" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid x:Name="dgOverdueQuick" Height="145" MouseDoubleClick="dgOverdueQuick_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã vay" Binding="{Binding idloan}" Width="78"/>
                                    <DataGridTextColumn Header="Khách hàng" Binding="{Binding fullname}" Width="*"/>
                                    <DataGridTextColumn Header="Còn lại (VNĐ)" Binding="{Binding remainamount, StringFormat={}{0:N0}}" Width="115"/>
                                    <DataGridTemplateColumn Header="Nhóm nợ" Width="85">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding debtgroup, Converter={StaticResource StatusBrush}, ConverterParameter=bg}"
                                                        CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding debtgroup}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="{Binding debtgroup, Converter={StaticResource StatusBrush}, ConverterParameter=fg}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
