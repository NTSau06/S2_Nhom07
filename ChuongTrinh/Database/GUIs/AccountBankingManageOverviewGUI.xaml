<local:AuthenticatedWindow x:Class="BankingManagesandServicesApp.GUIs.AccountBankingManageOverviewGUI"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
 Title="Tài khoản khách hàng" Width="1050" Height="650" MinWidth="850" MinHeight="500" WindowStartupLocation="CenterOwner">
 <DockPanel>
  <local:SessionHeader DockPanel.Dock="Top"/>
  <StackPanel DockPanel.Dock="Top" Margin="24,20,24,16">
   <TextBlock Text="Tài khoản khách hàng" FontSize="25" FontWeight="Bold" Foreground="#142D4E"/>
   <TextBlock Text="Danh sách tài khoản liên quan đến các giao dịch." Foreground="#53667C" Margin="0,6,0,18"/>
   <DockPanel><Button Content="Tìm kiếm" DockPanel.Dock="Right" Click="Search_Click"/><TextBox x:Name="SearchBox" MaxLength="100" Margin="0,0,12,0" ToolTip="Nhập số tài khoản hoặc họ tên"/></DockPanel>
  </StackPanel>
  <DockPanel DockPanel.Dock="Bottom" Margin="24,12,24,18"><Button Content="Quay lại nhật ký giao dịch" DockPanel.Dock="Right" Click="Back_Click"/><TextBlock x:Name="MessageText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
  <DataGrid x:Name="AccountsGrid" Margin="24,0">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Số tài khoản" Binding="{Binding idacc}" Width="160"/>
    <DataGridTextColumn Header="Khách hàng" Binding="{Binding fullname}" Width="*"/>
    <DataGridTextColumn Header="Điện thoại" Binding="{Binding phone}" Width="150"/>
    <DataGridTextColumn Header="Loại tài khoản" Binding="{Binding typeacc}" Width="160"/>
    <DataGridTextColumn Header="Số dư (VND)" Binding="{Binding money, StringFormat=N0}" Width="160"/>
   </DataGrid.Columns>
  </DataGrid>
 </DockPanel>
</local:AuthenticatedWindow>
