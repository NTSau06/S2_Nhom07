<Window x:Class="BankingManagesandServicesApp.GUIs.TransactionGoalsGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quản lý mục tiêu và đánh giá giao dịch" Height="620" Width="1000" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Quản lý mục tiêu và đánh giá giao dịch"
                   FontSize="24" FontWeight="Bold" Foreground="#142D4E" Margin="0,0,0,12"/>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,10,0,0" Foreground="#176B97"/>

        <TabControl>
            <!-- UC1.2.5.1 Quản lý KPI -->
            <TabItem Header="Quản lý KPI">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Tên chỉ tiêu" VerticalAlignment="Center"/>
                        <TextBox x:Name="NameBox" Width="200" Margin="5,0,15,0"/>
                        <TextBlock Text="Loại GD" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TypeBox" Width="140" Margin="5,0,15,0"/>
                        <TextBlock Text="Mục tiêu (VND)" VerticalAlignment="Center"/>
                        <TextBox x:Name="TargetBox" Width="140" Margin="5,0,15,0"/>
                        <Button Content="Thêm mới" Click="New_Click" Margin="0,0,8,0"/>
                        <Button Content="Lưu" Click="Save_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="KpiGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionChanged="KpiGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Code}" Width="70"/>
                            <DataGridTextColumn Header="Tên chỉ tiêu" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding Type}" Width="140"/>
                            <DataGridTextColumn Header="Mục tiêu (VND)" Binding="{Binding Target, StringFormat=N0}" Width="140"/>
                            <DataGridTextColumn Header="Thực hiện (VND)" Binding="{Binding Actual, StringFormat=N0}" Width="140"/>
                            <DataGridTextColumn Header="Hoàn thành" Binding="{Binding Completion}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- UC1.2.5.2 Đánh giá quy mô giao dịch -->
            <TabItem Header="Đánh giá quy mô giao dịch">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock x:Name="TotalCountText" FontSize="16" FontWeight="SemiBold" Margin="0,0,40,0"/>
                        <TextBlock x:Name="TotalAmountText" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <DataGrid x:Name="VolumeGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding Type}" Width="*"/>
                            <DataGridTextColumn Header="Số giao dịch" Binding="{Binding Count, StringFormat=N0}" Width="120"/>
                            <DataGridTextColumn Header="Tổng giá trị (VND)" Binding="{Binding Amount, StringFormat=N0}" Width="180"/>
                            <DataGridTemplateColumn Header="Tỉ trọng" Width="250">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Value="{Binding Share, Mode=OneWay}" Maximum="100" Height="14" Margin="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- UC1.2.5.3 Đánh giá chiến lược -->
            <TabItem Header="Đánh giá chiến lược">
                <DataGrid x:Name="StrategyGrid" Margin="10" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Dịch vụ" Binding="{Binding Service}" Width="*"/>
                        <DataGridTextColumn Header="Kỳ trước (VND)" Binding="{Binding Previous, StringFormat=N0}" Width="170"/>
                        <DataGridTextColumn Header="Kỳ này (VND)" Binding="{Binding Current, StringFormat=N0}" Width="170"/>
                        <DataGridTextColumn Header="Tăng trưởng" Binding="{Binding Growth}" Width="100"/>
                        <DataGridTextColumn Header="Đánh giá" Binding="{Binding Assessment}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- UC1.2.5.4 Xuất báo cáo -->
            <TabItem Header="Xuất báo cáo">
                <StackPanel Margin="20" Width="320" HorizontalAlignment="Left">
                    <TextBlock Text="Loại báo cáo"/>
                    <ComboBox x:Name="ReportTypeBox" SelectedIndex="0" Margin="0,5,0,12">
                        <ComboBoxItem Content="Báo cáo KPI"/>
                        <ComboBoxItem Content="Báo cáo quy mô giao dịch"/>
                        <ComboBoxItem Content="Báo cáo đánh giá chiến lược"/>
                    </ComboBox>
                    <TextBlock Text="Từ ngày"/>
                    <DatePicker x:Name="FromDate" Margin="0,5,0,12"/>
                    <TextBlock Text="Đến ngày"/>
                    <DatePicker x:Name="ToDate" Margin="0,5,0,16"/>
                    <Button Content="Xuất file" Click="Export_Click" Height="34"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>