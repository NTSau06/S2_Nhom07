<local:AuthenticatedWindow x:Class="BankingManagesandServicesApp.GUIs.TransactionLogGUI"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
 Title="Quản lý nhật ký giao dịch" Width="1280" Height="900" MinWidth="1100" MinHeight="800" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <local:SessionHeader DockPanel.Dock="Top"/>
  <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
   <DockPanel><Button DockPanel.Dock="Right" Content="Tài khoản khách hàng" Click="Accounts_Click"/>
    <StackPanel><TextBlock Text="Quản lý nhật ký giao dịch" FontSize="25" FontWeight="Bold" Foreground="#142D4E"/>
     <TextBlock Text="Sàng lọc, thống kê giao dịch, xem nhật ký và lập chứng từ." Foreground="#53667C" Margin="0,4,0,16"/></StackPanel>
   </DockPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Mã giao dịch / tài khoản / tên khách hàng"/><TextBox x:Name="KeywordBox" MaxLength="100" Margin="0,5,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Trạng thái"/><ComboBox x:Name="StatusBox" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Thành công"/><ComboBoxItem Content="Đang xử lý"/><ComboBoxItem Content="Thất bại"/></ComboBox></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Từ ngày"/><DatePicker x:Name="FromDate" Margin="0,5,0,0" Padding="5"/></StackPanel>
    <StackPanel Grid.Column="3" Margin="0,0,10,0"><TextBlock Text="Đến ngày"/><DatePicker x:Name="ToDate" Margin="0,5,0,0" Padding="5"/></StackPanel>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="SearchButton" Content="Sàng lọc" Click="Search_Click"/><Button x:Name="ResetButton" Content="Đặt lại" Click="Reset_Click" Background="#DCE6F1" Foreground="#142D4E"/></StackPanel>
   </Grid>
   <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,10,0"><TextBlock Text="Loại giao dịch"/><ComboBox x:Name="TypeBox" IsEditable="True" Margin="0,5,0,0" ToolTip="Để trống để chọn tất cả; có thể nhập loại giao dịch khác."/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,10,0"><TextBlock Text="Số tiền từ (VND)"/><TextBox x:Name="MinimumAmountBox" MaxLength="25" Margin="0,5,0,0" ToolTip="Nhập số nguyên VND, ví dụ: 500000"/></StackPanel>
    <StackPanel Grid.Column="2" Margin="0,0,10,0"><TextBlock Text="Số tiền đến (VND)"/><TextBox x:Name="MaximumAmountBox" MaxLength="25" Margin="0,5,0,0" ToolTip="Nhập số nguyên VND, ví dụ: 10000000"/></StackPanel>
    <StackPanel Grid.Column="3"><TextBlock Text="Cảnh báo giao dịch"/><ComboBox x:Name="FlagBox" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="Tất cả"/><ComboBoxItem Content="Có cảnh báo"/><ComboBoxItem Content="Không có cảnh báo"/></ComboBox></StackPanel>
   </Grid>
   <Border Background="#E4EDF6" Padding="12" Margin="0,14,0,0">
    <StackPanel><TextBlock Text="Thống kê trên kết quả sàng lọc đã áp dụng" FontWeight="SemiBold"/>
     <TextBlock x:Name="SummaryText" Text="Chưa tải dữ liệu" Margin="0,6,0,0" TextWrapping="Wrap"/>
     <TextBlock x:Name="AmountSummaryText" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
  </StackPanel>
  <Border DockPanel.Dock="Bottom" Margin="24,0,24,16" Padding="12" Background="#E4EDF6"><TextBlock x:Name="MessageText" Text="Đang tải dữ liệu…" TextWrapping="Wrap"/></Border>
  <TabControl Margin="24,0,24,14">
   <TabItem Header="Giao dịch và nhật ký">
  <Grid Margin="10"><Grid.RowDefinitions><RowDefinition Height="1.1*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DataGrid x:Name="TransactionsGrid" SelectionChanged="Transaction_Selected" AutomationProperties.Name="Danh sách giao dịch">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Mã giao dịch" Binding="{Binding Id}" Width="140"/>
     <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountNumber}" Width="135"/>
     <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="160"/>
     <DataGridTextColumn Header="Số tiền" Binding="{Binding AmountText}" Width="160"/>
     <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding TransactionType}" Width="130"/>
     <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="115"/>
     <DataGridTextColumn Header="Thời gian" Binding="{Binding TimeText}" Width="165"/>
     <DataGridTextColumn Header="Cảnh báo" Binding="{Binding FlagText}" Width="110"/>
    </DataGrid.Columns>
   </DataGrid>
   <DockPanel Grid.Row="1" Margin="0,16,0,10">
    <Button x:Name="ReceiptButton" DockPanel.Dock="Right" Content="Xem / Xuất chứng từ" Click="Receipt_Click" IsEnabled="False"/>
    <StackPanel><TextBlock Text="Nhật ký của giao dịch được chọn" FontWeight="SemiBold" FontSize="18"/>
     <TextBlock x:Name="SelectionText" Text="Chưa chọn giao dịch" Foreground="#53667C" Margin="0,4,0,0"/></StackPanel>
   </DockPanel>
   <DataGrid Grid.Row="2" x:Name="LogsGrid" AutomationProperties.Name="Nhật ký giao dịch">
    <DataGrid.Columns>
     <DataGridTextColumn Header="Thời gian" Binding="{Binding Time, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="170"/>
     <DataGridTextColumn Header="Thao tác" Binding="{Binding Action}" Width="145"/>
     <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="120"/>
     <DataGridTextColumn Header="Chi tiết" Binding="{Binding Details}" Width="*" MinWidth="240"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/><Setter Property="ToolTip" Value="{Binding Details}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
    </DataGrid.Columns>
   </DataGrid>
  </Grid>
   </TabItem>
   <TabItem x:Name="StatisticsTab" Header="Thống kê giao dịch">
    <Grid Margin="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="Theo trạng thái" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <DataGrid x:Name="StatusStatisticsGrid" Grid.Row="1" AutomationProperties.Name="Thống kê theo trạng thái">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Trạng thái" Binding="{Binding Group}" Width="*"/>
       <DataGridTextColumn Header="Số giao dịch" Binding="{Binding Count}" Width="140"/>
       <DataGridTextColumn Header="Tổng số tiền" Binding="{Binding TotalAmountText}" Width="240"/>
       <DataGridTextColumn Header="Có cảnh báo" Binding="{Binding FlaggedCount}" Width="140"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="2" Text="Theo loại giao dịch" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
     <DataGrid x:Name="TypeStatisticsGrid" Grid.Row="3" AutomationProperties.Name="Thống kê theo loại giao dịch">
      <DataGrid.Columns>
       <DataGridTextColumn Header="Loại giao dịch" Binding="{Binding Group}" Width="*"/>
       <DataGridTextColumn Header="Số giao dịch" Binding="{Binding Count}" Width="140"/>
       <DataGridTextColumn Header="Tổng số tiền" Binding="{Binding TotalAmountText}" Width="240"/>
       <DataGridTextColumn Header="Tỷ lệ thành công" Binding="{Binding SuccessRateText}" Width="140"/>
      </DataGrid.Columns>
     </DataGrid>
     <TextBlock Grid.Row="4" Text="Tổng số tiền cộng tất cả trạng thái; số tiền thành công chỉ cộng giao dịch thành công. Đây là giá trị giao dịch, không phải số dư hay doanh thu." TextWrapping="Wrap" Foreground="#53667C" Margin="0,12,0,0"/>
    </Grid>
   </TabItem>
  </TabControl>
 </DockPanel>
</local:AuthenticatedWindow>
