<UserControl x:Class="BankingManagesandServicesApp.GUIs.SessionHeader"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Background="#142D4E" Padding="20,12">
  <DockPanel>
   <Button DockPanel.Dock="Right" Content="Đăng xuất" Click="Logout_Click" Background="#FFFFFF" Foreground="#142D4E" Margin="18,0,0,0"/>
   <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
    <TextBlock x:Name="UserNameText" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
    <TextBlock x:Name="RoleText" Foreground="#BCD1EC" FontSize="12" HorizontalAlignment="Right"/>
   </StackPanel>
   <StackPanel><TextBlock Text="BANKING • NHÓM 07" Foreground="White" FontWeight="Bold" FontSize="16"/>
    <TextBlock Text="Quản lý giao dịch ngân hàng" Foreground="#BCD1EC" FontSize="12"/></StackPanel>
  </DockPanel>
 </Border>
</UserControl>
