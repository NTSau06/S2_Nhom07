<Window x:Class="BankingManagesandServicesApp.GUIs.AccountBankAddGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
        mc:Ignorable="d"
        Title="AccountBankAddGUI" Height="450" Width="800">
    <Grid>
        <Label Content="CCCD:" HorizontalAlignment="Left" Height="30" Margin="110,88,0,0" VerticalAlignment="Top" Width="46" RenderTransformOrigin="1.052,0.508"/>
        <Label Content="Họ và Tên:" HorizontalAlignment="Left" Height="30" Margin="88,151,0,0" VerticalAlignment="Top" Width="68" RenderTransformOrigin="-0.132,0.768"/>
        <TextBox x:Name="FullNameText" HorizontalAlignment="Left" Height="30" Margin="174,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153"/>
        <Label Content="Giới tính:" HorizontalAlignment="Left" Height="24" Margin="88,211,0,0" VerticalAlignment="Top" Width="68"/>
        <ComboBox x:Name="GenderText" HorizontalAlignment="Left" Height="24" Margin="174,213,0,0" VerticalAlignment="Top" Width="153" SelectedIndex="0">
            <ComboBoxItem Content="Nam" />
            <ComboBoxItem Content="Nữ" />
        </ComboBox>
        <Label Content="Số điện thoại:" HorizontalAlignment="Left" Height="30" Margin="448,151,0,0" VerticalAlignment="Top" Width="109"/>
        <TextBox x:Name="PhoneText" HorizontalAlignment="Left" Height="30" Margin="557,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153"/>
        <Label Content="Loại tài khoản:" HorizontalAlignment="Left" Height="26" Margin="448,271,0,0" VerticalAlignment="Top" Width="92"/>
        <ComboBox x:Name="TypeText" HorizontalAlignment="Left" Height="26" Margin="557,271,0,0" VerticalAlignment="Top" Width="153" SelectedIndex="0">
            <ComboBoxItem Content="Tài khoản thanh toán" />
            <ComboBoxItem Content="Tài khoản tiết kiệm" />
            <ComboBoxItem Content="Tài khoản vay" />
        </ComboBox>
        <Label Content="Ngày sinh:" HorizontalAlignment="Left" Height="30" Margin="465,88,0,0" VerticalAlignment="Top" Width="92"/>
        <TextBox x:Name="BirthdayText" HorizontalAlignment="Left" Height="30" Margin="557,88,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153"/>
        <Label Content="Mục Thêm Tài Khoản" HorizontalAlignment="Center" Height="34" Margin="0,28,0,0" VerticalAlignment="Top" Width="120"/>
        <Button Content="Hoàn Thành" HorizontalAlignment="Left" Height="46" Margin="430,361,0,0" VerticalAlignment="Top" Width="161" Click="SukienHoanThanh"/>
        <Button Content="Làm Mới" HorizontalAlignment="Left" Height="46" Margin="200,361,0,0" VerticalAlignment="Top" Width="160" Click="SukienLamMoi"/>
        <Label Content="Địa chỉ:" HorizontalAlignment="Left" Height="24" Margin="468,213,0,0" VerticalAlignment="Top" Width="89"/>
        <TextBox x:Name="AddressText" HorizontalAlignment="Left" Height="30" Margin="557,208,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153"/>
        <Label Content="Email:" HorizontalAlignment="Left" Height="26" Margin="99,271,0,0" VerticalAlignment="Top" Width="68"/>
        <TextBox x:Name="EmailText" HorizontalAlignment="Left" Height="30" Margin="174,267,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153"/>
        <ComboBox x:Name="CCCDComboBox" HorizontalAlignment="Left" Height="24" Margin="174,91,0,0" VerticalAlignment="Top" Width="153" SelectedIndex="0" SelectionChanged="CCCDComboBox_SelectionChanged" IsEditable="True"/>
    </Grid>
</Window>