<Window x:Class="BankingManagesandServicesApp.GUIs.AccountBankFixGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
        mc:Ignorable="d"
        Title="AccountBankFixGUI" Height="450" Width="800">
    <Grid>
        <Label Content="Mã tài khoản:" HorizontalAlignment="Left" Height="30" Margin="72,88,0,0" VerticalAlignment="Top" Width="84" RenderTransformOrigin="1.052,0.508"/>
        <TextBox x:Name="IDText" HorizontalAlignment="Left" Height="30" Margin="174,88,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153" IsEnabled="False"/>
        <Label Content="Số điện thoại:" HorizontalAlignment="Left" Height="30" Margin="65,152,0,0" VerticalAlignment="Top" Width="109"/>
        <TextBox x:Name="PhoneText" HorizontalAlignment="Left" Height="30" Margin="174,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153" TextChanged="InputField_TextChanged"/>
        <Label Content="Địa chỉ:" HorizontalAlignment="Left" Height="28" Margin="450,157,0,0" VerticalAlignment="Top" Width="89"/>
        <TextBox x:Name="AddressText" HorizontalAlignment="Left" Height="30" Margin="539,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153" TextChanged="InputField_TextChanged"/>
        <Label Content="Email:" HorizontalAlignment="Left" Height="26" Margin="284,221,0,0" VerticalAlignment="Top" Width="68"/>
        <TextBox x:Name="EmailText" HorizontalAlignment="Left" Height="30" Margin="359,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153" TextChanged="InputField_TextChanged"/>
        <Label Content="Chỉnh Sửa Tài Khoản" HorizontalAlignment="Center" Height="35" Margin="0,21,0,0" VerticalAlignment="Top" Width="124"/>
        <Label Content="CCCD:" HorizontalAlignment="Left" Height="26" Margin="464,92,0,0" VerticalAlignment="Top" Width="68"/>
        <TextBox x:Name="CCCDText" HorizontalAlignment="Left" Height="30" Margin="539,88,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="153" IsEnabled="False"/>
        <Button Content="Hoàn tác" HorizontalAlignment="Left" Height="41" Margin="217,343,0,0" VerticalAlignment="Top" Width="135" Click="SukienHoanTac"/>
        <Button x:Name="HoanThanhButton" Content="Hoàn Thành" HorizontalAlignment="Left" Height="41" Margin="464,343,0,0" VerticalAlignment="Top" Width="122" Click="SukienHoanThanh" IsEnabled="False"/>

    </Grid>
</Window>
