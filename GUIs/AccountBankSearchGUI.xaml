<Window x:Class="BankingManagesandServicesApp.GUIs.AccountBankSearchGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
        mc:Ignorable="d"
        Title="AccountBankSearchGUI" Height="450" Width="800"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="TÌM KIẾM TÀI KHOẢN"
                   FontSize="18"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,18"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <!-- Mã tài khoản -->
            <Label Grid.Row="0" Grid.Column="0" Content="Mã tài khoản:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSearchId" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

            <!-- CCCD -->
            <Label Grid.Row="1" Grid.Column="0" Content="CCCD:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSearchCCCD" Grid.Row="1" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

            <!-- Loại tài khoản -->
            <Label Grid.Row="2" Grid.Column="0" Content="Loại tài khoản:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CboSearchType" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" SelectedIndex="0">
                <ComboBoxItem Content="Tất cả"/>
                <ComboBoxItem Content="Tài khoản thanh toán"/>
                <ComboBoxItem Content="Tài khoản tiết kiệm"/>
                <ComboBoxItem Content="Tài khoản vay"/>
            </ComboBox>

            <!-- Số tiền nhỏ nhất -->
            <Label Grid.Row="3" Grid.Column="0" Content="Số tiền trong khoảng:" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtMinMoney" Grid.Row="3" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="0,5,501,5"/>

            <!-- Số tiền lớn nhất -->
            <TextBox x:Name="TxtMaxMoney" Grid.Row="3" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Margin="176,5,326,5"/>
            <Label Grid.Column="1" Content="-" HorizontalAlignment="Left" Margin="129,5,0,6" Grid.Row="3" Width="24" RenderTransformOrigin="0.742,-0.915"/>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button Content="Làm Mới"
                    Width="90"
                    Height="34"
                    Click="SukienLamMoi"/>
            <Button x:Name="SearchButton" Content="Tìm Kiếm"
                    Width="135"
                    Height="34"
                    FontWeight="SemiBold"
                    Click="SukienTimKiem"/>
        </StackPanel>
    </Grid>
</Window>