<Window x:Class="BankingManagesandServicesApp.GUIs.AccountBankingManageOverviewGUI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BankingManagesandServicesApp.GUIs"
        mc:Ignorable="d"
        Title="AccountBankingManageOverviewGUI" Height="450" Width="800"
        ResizeMode="NoResize">
    <Grid>
        <Label Content="MỤC QUẢN LÝ TÀI KHOẢN KHÁCH HÀNG TỔNG QUAN " HorizontalAlignment="Center" Height="36" Margin="0,18,0,0" VerticalAlignment="Top" Width="308" RenderTransformOrigin="0.52,2.229"/>
        <Button Content="Thêm Tài Khoản" HorizontalAlignment="Left" Height="42" Margin="143,367,0,0" VerticalAlignment="Top" Width="210" Click="SukienThemTaiKhoan"/>
        <Button Content="Tìm Kiếm Tài Khoản" HorizontalAlignment="Left" Height="42" Margin="420,367,0,0" VerticalAlignment="Top" Width="210" Click="SukienTimKiemTaiKhoan"/>
        <DataGrid x:Name="AccountDataGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
          RowHeaderWidth="0" Margin="36,54,36,173">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã Tài Khoản" Binding="{Binding idacc}" Width="140"/>
                <DataGridTextColumn Header="Họ và tên" Binding="{Binding fullname}" Width="120"/>
                <DataGridTextColumn Header="Giới Tính" Binding="{Binding gender}" Width="80"/>
                <DataGridTextColumn Header="Ngày Sinh" Binding="{Binding birthday, StringFormat=yyyy-MM-dd}" Width="80"/>
                <DataGridTextColumn Header="Loại tài khoản" Binding="{Binding typeacc}" Width="160"/>

                <!-- Cột hành động: chỉ hiện 2 icon khi rê chuột vào dòng -->
                <DataGridTemplateColumn Header="Thao tác" Width="133">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <!-- Icon Con mắt: Xem chi tiết -->
                                <Button ToolTip="Xem chi tiết"
                                Tag="{Binding idacc}"
                                Click="SukienXemChiTietTaiKhoan"
                                Margin="0,0,8,0"
                                Padding="6,2"
                                Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- Nếu đang chọn dòng đó thì vẫn giữ hiện để dễ bấm -->
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="👁" FontSize="14"/>
                                </Button>

                                <!-- Icon Bút chì: Cập nhật tài khoản -->
                                <Button ToolTip="Cập nhật tài khoản"
                                Tag="{Binding idacc}"
                                Click="SukienChinhSuaTaiKhoan"
                                Padding="6,2"
                                Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="✏️" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
