        <UserObject label="" mermaidData="{&#10;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;: \&quot;base\&quot;, \&quot;themeVariables\&quot;: {\&quot;background\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;primaryTextColor\&quot;: \&quot;#000000\&quot;, \&quot;primaryBorderColor\&quot;: \&quot;#000000\&quot;, \&quot;lineColor\&quot;: \&quot;#000000\&quot;, \&quot;secondaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;secondaryTextColor\&quot;: \&quot;#000000\&quot;, \&quot;secondaryBorderColor\&quot;: \&quot;#000000\&quot;, \&quot;tertiaryColor\&quot;: \&quot;#ffffff\&quot;, \&quot;tertiaryTextColor\&quot;: \&quot;#000000\&quot;, \&quot;tertiaryBorderColor\&quot;: \&quot;#000000\&quot;, \&quot;mainBkg\&quot;: \&quot;#ffffff\&quot;, \&quot;classText\&quot;: \&quot;#000000\&quot;, \&quot;edgeLabelBackground\&quot;: \&quot;#ffffff\&quot;, \&quot;nodeBorder\&quot;: \&quot;#000000\&quot;}}}%%\nclassDiagram\ndirection LR\n\n%% Chi ve cac lop Data o cuoi sequence (khong ve GUI, Control)\nclass AccountBank {\n    -idacc: String\n    -passwordacc: String\n    -fullname: String\n    -gender: String\n    -birthday: Date\n    -CCCD: String\n    -phone: String\n    -typeacc: String\n    -provideaccdate: Date\n    -money: int\n    +detailaccount(idacc: String) AccountBank\n}\n\nclass TransactionBank {\n    -idtrs: String\n    -idacc: String\n    -amount: Decimal\n    -transactionType: String\n    -status: String\n    -transactionTime: DateTime\n    -description: String\n    -isFlagged: boolean\n    -flagReason: String\n    -flaggedAt: DateTime\n    +getDetail(idtrs: String) TransactionBank\n    +queryTransactions(condition: String) List~TransactionBank~\n    +markTransaction(reason: String) boolean\n    +exportReceipt(format: String) File\n}\n\nclass TransactionLog {\n    -logId: long\n    -idtrs: String\n    -action: String\n    -timestamp: DateTime\n    -result: String\n    -details: String\n    +getLogList() List~TransactionLog~\n    +searchLogs(keyword: String) List~TransactionLog~\n    +writeLog() boolean\n}\n\nclass StatisticsReport {\n    -reportId: String\n    -fromDate: DateTime\n    -toDate: DateTime\n    -transactionType: String\n    -statusFilter: String\n    -minAmount: Decimal\n    -maxAmount: Decimal\n    -groupBy: String\n    -chartType: String\n    -totalTransactions: int\n    -totalAmount: Decimal\n    -createdAt: DateTime\n    +generateReport() boolean\n    +getReportDetails() StatisticsReport\n    +exportReport(format: String) File\n}\n\nAccountBank \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TransactionBank : owns\nTransactionBank \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TransactionLog : has_events\nStatisticsReport ..&gt; TransactionBank : aggregates_from\n&quot;,&#10;  &quot;config&quot;: null,&#10;  &quot;version&quot;: &quot;12&quot;&#10;}" id="-cLqDakZo79Yi2AxofbR-1">
